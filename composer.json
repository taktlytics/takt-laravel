{
    "name": "vskstudio/takt-laravel",
    "description": "Laravel integration for Takt analytics: @takt Blade directive + Takt facade for server-side events.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "analytics",
        "takt",
        "laravel",
        "privacy",
        "tracking",
        "blade"
    ],
    "homepage": "https://github.com/taktlytics/takt-laravel",
    "authors": [
        {
            "name": "vskstudio"
        }
    ],
    "support": {
        "issues": "https://github.com/taktlytics/takt-laravel/issues",
        "source": "https://github.com/taktlytics/takt-laravel"
    },
    "require": {
        "php": ">=8.1",
        "vskstudio/takt-core-php": "^0.7.3",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "phpstan/phpstan": "^1.11",
        "laravel/pint": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Vskstudio\\Takt\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vskstudio\\Takt\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vskstudio\\Takt\\Laravel\\TaktServiceProvider"
            ],
            "aliases": {
                "Takt": "Vskstudio\\Takt\\Laravel\\Facades\\Takt"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.99"
        }
    },
    "minimum-stability": "stable"
}
